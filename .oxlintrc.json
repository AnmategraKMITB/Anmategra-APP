// Semua kategori bun lint menyala sebagai error (aturan lama yang dulu "warn" juga), ditambah setiap aturan tanpa
// kategori. Yang dimatikan hanya aturan yang bertentangan dengan aturan lain atau
// dengan platform; alasannya ada di atas tiap aturan. Pelanggaran lama dicatat di
// oxlint-suppressions.json (bun run lint:prune setelah memperbaikinya).
{
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "import",
    "jsx-a11y",
    "unicorn",
    "oxc",
    "promise",
    "node",
    "react-perf",
    "vitest"
  ],
  "jsPlugins": [
    "./lint/drizzle.js"
  ],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "next-env.d.ts",
    "src/components/ui/**",
    "docs/**",
    "drizzle/**",
    "public/**",
    "src/app/prototype/oprec/_components/*.jsx"
  ],
  "rules": {
    "@typescript-eslint/class-methods-use-this": "error",
    "@typescript-eslint/default-param-last": "error",
    "@typescript-eslint/init-declarations": "error",
