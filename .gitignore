/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite
anmategra.dump
anmategra_schema.sql

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lembaga summarizer checkpoint (contains scraped public profile text)
scripts/.km-summarize-cache.json

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

.vscode

# raw source spreadsheets (contain contact data; keep out of git history)
*.xlsx

# bug-hunter skill scan artifacts
.bug-hunter/
