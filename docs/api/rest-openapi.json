    "/api/manual": {
      "get": {
        "operationId": "manual_download",
        "tags": ["excel"],
        "summary": "Unduh manual penggunaan (PDF)",
        "description": "Berkas statis, tanpa autentikasi.",
        "security": [],
        "responses": {
          "200": {
            "description": "PDF manual.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Manual belum tersedia di server.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
