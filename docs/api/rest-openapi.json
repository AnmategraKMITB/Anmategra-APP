    "/api/forms/{formId}/respons": {
      "get": {
        "operationId": "spreadsheet_export_form_responses",
        "tags": ["excel"],
        "summary": "Ekspor respons form (XLSX)",
        "description": "Semua respons form dalam satu tab. `format=csv` dialihkan ke `/respons.csv` (dialirkan per halaman). Akses sama dengan halaman Respons.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID form."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["xlsx", "csv"],
              "default": "xlsx"
            },
            "description": "Format berkas. CSV hanya memuat tab pertama."
          }
        ],
        "responses": {
          "200": {
            "description": "Berkas spreadsheet sebagai attachment. XLSX yang sama dipakai tombol \"Buka di Google Sheets\" (diunggah ke Drive pengguna dari peramban).",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=\"...\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` — belum login.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN` — tidak punya akses ke halaman sumber datanya.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND` — resource tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          }
        }
      }
    },
