  "components": {
    "schemas": {
      "RestError": {
        "type": "object",
        "description": "Bentuk error seragam untuk endpoint REST di `src/app/api/lembaga/**` (lihat `src/utils/api-error.ts`).",
        "required": ["error", "code"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Pesan yang bisa ditampilkan ke pengguna."
          },
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED",
              "FORBIDDEN",
              "BAD_REQUEST",
              "NOT_FOUND",
              "VALIDATION_ERROR",
              "INTERNAL_ERROR"
            ]
          },
          "details": {
            "description": "Detail tambahan, misal baris Excel yang gagal divalidasi."
          }
        }
      },
      "RestImportResult": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "description": "Ringkasan hasil impor, misal jumlah baris yang masuk."
          }
        }
      }
    }
  }
