{
  "paths": {
    "/api/lembaga/{lembaga_id}/anggota": {
      "get": {
        "operationId": "excel_export_anggota_lembaga",
        "tags": ["excel"],
        "summary": "Unduh template/ekspor anggota lembaga",
        "description": "Mengunduh daftar anggota lembaga sebagai workbook Excel. Dipakai sebagai template untuk POST.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "lembaga_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID lembaga. Pemanggil harus Owner atau Admin Lembaga ini."
          }
        ],
        "responses": {
          "200": {
            "description": "File .xlsx sebagai attachment.",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=...xlsx",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "`BAD_REQUEST` — parameter path kosong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` — belum login.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN` — bukan Owner/Admin dari resource ini.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND` — resource tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "excel_import_anggota_lembaga",
        "tags": ["excel"],
        "summary": "Impor anggota lembaga dari file Excel",
        "description": "Mengganti/menambah anggota lembaga dari workbook Excel. Diproses dalam satu transaksi; snapshot riwayat organisasi ikut ditulis untuk anggota yang keluar.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "lembaga_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID lembaga. Pemanggil harus Owner atau Admin Lembaga ini."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Berkas .xlsx atau .xls hasil edit dari template GET."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Impor sukses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestImportResult"
                }
              }
            }
          },
          "400": {
            "description": "`BAD_REQUEST` / `VALIDATION_ERROR` — file tidak ada, format salah, worksheet tidak ditemukan, atau isi baris invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` — belum login.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN` — bukan Owner/Admin dari resource ini.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND` — resource tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL_ERROR` — gagal memproses berkas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestError"
                }
              }
            }
          }
        }
      }
    },
