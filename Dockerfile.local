# Image untuk pengembangan lokal: `next dev` dengan hot reload.
# Image production tetap di `Dockerfile`. Dipakai lewat `compose.local.yml`.
FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

# Bun versi repo (lihat scripts/install-bun.sh) hanya dipakai untuk memasang
# dependency dan menjalankan script; Next.js tetap berjalan di Node.
COPY scripts/install-bun.sh scripts/install-bun.sh
RUN sh scripts/install-bun.sh
ENV PATH=/root/.bun/bin:$PATH

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Kode sumber di-bind-mount oleh compose; COPY ini hanya supaya image tetap bisa
# jalan sendiri tanpa mount.
COPY . .

EXPOSE 3000
CMD ["sh", "./docker/local/app-start.sh"]
