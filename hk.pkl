amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

// Hook git lokal. Dipasang otomatis oleh `bun install` (script `prepare` ->
// scripts/install-hk.sh), jadi tidak bergantung pada orang atau agen yang ingat.
//   pre-commit: format dan lint berkas yang di-stage, perbaikannya ikut di-stage.
//   pre-push:   pengecekan yang sama dengan job "Checks" di CI.

local code = List("**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}")

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["fmt"] {
        glob = List("**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,jsonc,css,md,mdx,yml,yaml,html}")
        check = "bun fmt --no-script --check {{files}}"
        fix = "bun fmt --no-script {{files}}"
      }
      ["lint"] {
        glob = code
        depends = List("fmt")
        check = "bun lint --no-script --type-aware --pass-on-unpruned-suppressions {{files}}"
        fix = "bun lint --no-script --type-aware --pass-on-unpruned-suppressions --fix {{files}}"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["checks"] {
        check = "bash scripts/ci/checks.sh"
      }
    }
  }
}
