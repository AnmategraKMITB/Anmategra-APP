# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/anmategra"

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET="SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Next Auth Google Provider
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# Next Auth Azure AD Provider (login mahasiswa, akun @mahasiswa.itb.ac.id)
# Client ID & secret dari app registration Anmategra (lihat README, "Login Microsoft").
# Secret punya masa berlaku; kalau login Microsoft tiba-tiba gagal, cek ini dulu.
AZURE_AD_CLIENT_ID="AZURE_AD_CLIENT_ID"
AZURE_AD_CLIENT_SECRET="AZURE_AD_CLIENT_SECRET"
# Directory ID milik ITB (publik, bukan rahasia). Login hanya diterima dari tenant ini.
AZURE_AD_TENANT_ID="db6e1183-4c65-405c-82ce-7cd53fa6e9dc"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Deployment: production | demo. Demo mengaktifkan login kredensial dan data uji.
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
# Email superadmin (dipisah koma). Berlaku untuk SSO dan demo.
SUPERADMIN_EMAILS="13523094@mahasiswa.itb.ac.id,anmategra@km.itb.ac.id"
# Hash password demo (scrypt). Generate dengan:
#   npx tsx scripts/demo/hash-password.ts
DEMO_PASSWORD_HASH=""
# Host yang dipakai middleware untuk redirect admin dan penjagaan demo.
ADMIN_HOST="admin.anmategra.com"
DEMO_HOST="demo.anmategra.com"
# Hanya satu service per database yang boleh menjalankan migrasi saat start.
# Set false untuk admin-prod yang memakai database produksi yang sama.
RUN_MIGRATIONS="true"

# Analytics & Search Console (opsional; kosongkan untuk mematikan)
# Measurement ID GA4, ambil dari GA4 Admin > Data Streams.
NEXT_PUBLIC_GA_ID=""
# Token dari Search Console > Verifikasi metode "HTML tag". Isi hanya nilai
# content-nya, bukan seluruh tag <meta>.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Unggah berkas OneDrive di Forms (aplikasi Microsoft bertipe SPA; kosong = dinonaktifkan).
# Daftarkan <origin>/msal-redirect sebagai SPA redirect di Azure (mis.
# https://anmategra.com/msal-redirect, http://localhost:3000/msal-redirect);
# tanpa itu popup masuk OneDrive berakhir dengan AADSTS50011.
NEXT_PUBLIC_AZURE_CLIENT_ID=""
NEXT_PUBLIC_AZURE_TENANT_ID=""
